#!/bin/sh
# Gestionnaire des jeux : indexation, surveillance USB, base locale
case "$1" in
  start)
    echo "[ConsoleOS] Démarrage du gestionnaire de jeux..."
    /usr/bin/consoleos-gamemgrd --db /data/library.db --games /data/games --watch /media &
    ;;
  stop)
    killall consoleos-gamemgrd 2>/dev/null
    ;;
  *) echo "usage: $0 {start|stop}" ;;
esac
