# Fragment de configuration noyau ConsoleOS
# Appliqué par-dessus la config RPi4 par défaut (bcm2711_defconfig)
# Objectif : légèreté, démarrage rapide, aucune fonctionnalité de bureau inutile

# --- Nécessaire ---
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_FB=y
CONFIG_SND=y
CONFIG_SND_BCM2835_SOC_I2S=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_SONY=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_NINTENDO=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HIDP=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_SECCOMP=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_BCM2835=y
CONFIG_EXT4_FS=y
CONFIG_CMDLINE_PARTITION=y

# --- Désactivé : gain de RAM et de temps de boot ---
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_KGDB is not set
# CONFIG_FTRACE is not set
# CONFIG_SND_USB is not set
# CONFIG_VIDEO_V4L2 is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SCSI is not set
# CONFIG_ISDN is not set
# CONFIG_PARPORT is not set
# CONFIG_INFINIBAND is not set
