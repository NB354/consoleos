# ConsoleOS - defconfig Raspberry Pi 4 (1 Go RAM)
BR2_arm=y
BR2_cortex_a72=y
BR2_ARM_FPU_NEON_VFPV4=y

BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_6=y

BR2_SYSTEM_BIN_SH_BASH=n
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="consoleos"
BR2_TARGET_GENERIC_ISSUE="ConsoleOS"
BR2_TARGET_GENERIC_GETTY_PORT=""

# Pas de bureau Linux, init minimal
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_ENABLE_NLS=n

# Noyau Linux minimal spécifique RPi4
# NB: on télécharge une archive tarball de la branche plutôt que de cloner
# tout le dépôt Git raspberrypi/linux (des centaines de Mo d'historique) :
# beaucoup plus rapide, surtout sur une machine ancienne/lente, et le
# téléchargement est repris/mis en cache normalement par Buildroot.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/raspberrypi/linux/archive/refs/heads/rpi-6.6.y.tar.gz"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CONSOLEOS_PATH)/board/consoleos/linux-consoleos-fragment.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Firmware / bootloader RPi
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RASPBERRYPI_USBBOOT=y
BR2_PACKAGE_ARM_TRUSTED_FIRMWARE=n

# Pilotes matériels essentiels
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_KHR_DISPLAY_V4L=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_NETWORKING=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_LIBEVDEV=y

# Bibliothèques nécessaires à l'UI et au gestionnaire de jeux
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_LIBARCHIVE=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBSODIUM=y

# Outils de diagnostic (mode développeur uniquement, désactivés par défaut)
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_STRACE=y

# Composants ConsoleOS
BR2_PACKAGE_CONSOLEOS_UI=y
BR2_PACKAGE_CONSOLEOS_GAMEMGR=y
BR2_PACKAGE_CONSOLEOS_SANDBOX=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_CONSOLEOS_PATH)/board/consoleos/users_table.txt"
BR2_PACKAGE_CONSOLEOS_PAD=y
BR2_PACKAGE_CONSOLEOS_UPDATE=y
BR2_PACKAGE_CONSOLEOS_NOTIFY=y

# Système de fichiers racine + genimage (carte microSD flashable)
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="900M"
BR2_TARGET_ROOTFS_EXT2_LABEL="consoleos_root"
BR2_TARGET_ROOTFS_EXT2_GEN_JOURNAL=n

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CONSOLEOS_PATH)/board/consoleos/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CONSOLEOS_PATH)/board/consoleos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CONSOLEOS_PATH)/board/consoleos/post-image.sh"

BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
